{
  "name": "portfolio-pedro-albuquerque",
  "private": true,
  "version": "0.23.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "verify": "npm run check:content && npm run check:assets && npm run typecheck && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
